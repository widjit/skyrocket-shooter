<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/ez_edit_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/btlrckt_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ez_geometry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/btlrckt_text_dim" />

        <TextView
            android:id="@+id/ez_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ez_self_intersect_warning"
            android:textColor="#FFFF5252"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ez_shape_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/ez_label"
            android:textColor="@color/btlrckt_text_dim" />

        <EditText
            android:id="@+id/ez_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/btlrckt_text" />

        <TextView
            android:id="@+id/ez_height_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="@color/btlrckt_text_dim" />

        <EditText
            android:id="@+id/ez_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/btlrckt_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/ez_fill_color"
            android:textColor="@color/btlrckt_text_dim" />

        <LinearLayout
            android:id="@+id/ez_fill_swatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/ez_fill_opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="@color/btlrckt_text_dim" />

        <SeekBar
            android:id="@+id/ez_fill_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/ez_stroke_color"
            android:textColor="@color/btlrckt_text_dim" />

        <LinearLayout
            android:id="@+id/ez_stroke_swatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/ez_stroke_width_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="@color/btlrckt_text_dim" />

        <SeekBar
            android:id="@+id/ez_stroke_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="11" />

        <CheckBox
            android:id="@+id/ez_stroke_dashed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ez_stroke_dashed"
            android:textColor="@color/btlrckt_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="@string/ez_remarks"
            android:textColor="@color/btlrckt_text_dim" />

        <EditText
            android:id="@+id/ez_remarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="@color/btlrckt_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/ez_btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ez_save"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/ez_btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ez_cancel"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ez_btn_redraw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ez_redraw"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/ez_btn_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ez_share"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/ez_btn_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ez_delete"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
